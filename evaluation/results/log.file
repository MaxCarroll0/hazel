  | Power(x, y) => exprToString(x) ++ "**" ++ exprToString(y)
  | Op(x, y, z) =>
      "(" ++ exprToString(x) ++ "*" ++ exprToString(y) ++ ")/" ++ exprToString(z)
end in let _ = exprToString(Op((VarX, VarY))) in ?

