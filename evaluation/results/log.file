  | VarX => "x"
  | VarY => "y"
  | Sine(n) => "sin(pi*" ++ exprToString(n) ++ ")"
  | Cosine(n) => "cos(pi*" ++ exprToString(n) ++ ")"
  | Average(x, y) =>
