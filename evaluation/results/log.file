type expr = 
  + VarX
  + VarY
  + Sine(expr)
  + Cosine(expr)
  + Average(expr, expr)
  + Times(expr, expr)
  + Thresh(expr, expr, expr, expr)
 in let evall : ? -> Float = fun (e, x, y) -> case e 
  | VarX => x
  | VarY => y
  | Sine(n) => sin(3.14 *. evall((n, x, y)))
  | Consine(n) => cos(3.14 *. evall((n, x, y)))
  | Average(m, n) => evall((m, x, y)) +. evall((n, x, y)) /. 2
  | Times(m, n) => evall((m, x, y)) *. evall((n, x, y))
end in ?

