  | VarY => "y"
  | Sine(m) => "sin(pi*" ++ exprToString(m) ++ ")"
  | Cosine(m) => "cos(pi*" ++ exprToString(m) ++ ")"
  | Square(m) => "(" ++ exprToString(m) ++ "^2)"
  | Average(m, n) =>
